# Optional path override (defaults to repository directory)
# SPRINGXYZ_BASE_DIR=/home/khojahlab/SpringXYZ
# XYZ_BASE_DIR=/home/khojahlab/SpringXYZ

# Flask server settings
FLASK_SECRET_KEY=microscopy_secret
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# AWS S3 Cloud Storage Settings
XYZ_S3_BUCKET=realtime-organoid-xyz-data
XYZ_S3_REGION=us-east-2

# Independent Drive backup; existing AWS image browser stays unchanged.
# Export these variables or use systemd EnvironmentFile; .env is not auto-loaded.
XYZ_DRIVE_BACKUP_ENABLED=false
XYZ_DRIVE_FOLDER_ID=1ttE0_okxThWxGyPuAqLBbRuuzV2Gzxa5
XYZ_DRIVE_BACKUP_INTERVAL=60
